#!/usr/bin/env bash
# bin/secret-restore - Restore sops secrets to their expected locations
# Useful after a fresh clone or when deploying to a new machine.
set -euo pipefail

FLAKE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$FLAKE_DIR"

echo ":: Restoring antigravity OAuth token..."
AGY_TOKEN_DIR="$HOME/.gemini/antigravity-cli"
mkdir -p "$AGY_TOKEN_DIR"
sops -d secrets/secrets.yaml \
  | python3 -c "
import sys, yaml
data = yaml.safe_load(sys.stdin)
val = data.get('antigravity_oauth_token', '')
# Strip surrounding quotes if stored as a YAML string
print(val.strip(\"'\"), end='')
" > "$AGY_TOKEN_DIR/antigravity-oauth-token"
chmod 600 "$AGY_TOKEN_DIR/antigravity-oauth-token"
echo "   -> Written to $AGY_TOKEN_DIR/antigravity-oauth-token"

echo ":: Done."
