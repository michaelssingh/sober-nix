#!/usr/bin/env bash
# bin/fly-status - Quick Fly.io instances health check
set -euo pipefail

BOLD=$'\e[1m'
CYAN=$'\e[36m'
GREEN=$'\e[32m'
YELLOW=$'\e[33m'
RED=$'\e[31m'
RESET=$'\e[0m'

# Ensure fly CLI is available
if ! command -v fly &>/dev/null; then
    echo -e "${RED}Error: fly CLI is not installed or not in PATH.${RESET}" >&2
    exit 1
fi

echo -e "${BOLD}${CYAN}==> Querying Fly.io App Statuses...${RESET}"

# Fetch apps list
apps_output=$(fly apps list 2>&1)

printf "\n${BOLD}%-20s   %-30s   %-20s${RESET}\n" "App Name" "Status" "Latest Deploy"
echo "----------------------------------------------------------------------"

# Filter and format the sober-* apps
# The output format is: NAME │ OWNER │ STATUS │ LATEST DEPLOY
echo "$apps_output" | grep -E '^[[:space:]]*sober-[a-z]+' | while read -r line; do
    name=$(echo "$line" | awk -F'│' '{print $1}' | xargs)
    status=$(echo "$line" | awk -F'│' '{print $3}' | xargs)
    latest_deploy=$(echo "$line" | awk -F'│' '{print $4}' | xargs)

    case "$status" in
        deployed|running|started)
            status_colored="${GREEN}● active${RESET}"
            ;;
        suspended)
            status_colored="${YELLOW}● suspended (idle/scale-to-zero)${RESET}"
            ;;
        *)
            status_colored="${RED}● $status${RESET}"
            ;;
    esac

    printf "%-20s   %-40s   %-20s\n" "$name" "$status_colored" "$latest_deploy"
done
echo ""
