#!/usr/bin/env bash
# bin/rebuild - Commit dirty tree then nixos-rebuild switch
# Usage: ./bin/rebuild [commit message]
set -euo pipefail

FLAKE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MSG="${1:-"chore: wip checkpoint before rebuild"}"

cd "$FLAKE_DIR"

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo ":: Dirty tree detected — committing before build..."
  git commit -a -m "$MSG"
fi

echo ":: Building NixOS configuration..."
nixos-rebuild build --flake .

echo ":: Switching to new generation..."
sudo nixos-rebuild switch --flake .

echo ":: Done. Active generation:"
nixos-rebuild list-generations --flake . 2>/dev/null | tail -n 5 || true
