#!/usr/bin/env bash
# bin/bootstrap-sprite — Bootstrapper for a new sprite.dev VM.
# Can be run locally on the host, or remotely on the VM.
# Orchestrates: Destroy VM → Create VM → Push Keys → Run Remote Installer

# If we are running locally on the host, run the orchestration wrapper
if [ "${1:-}" != "--remote" ]; then
    GREEN='\033[0;32m'; CYAN='\033[0;36m'; RED='\033[0;31m'; RESET='\033[0m'
    
    echo -e "${CYAN}==> 1. Checking sprite environment for active 'agy' instance...${RESET}"
    if sprite list | grep -q "agy"; then
        echo -e "${CYAN}==> 2. Destroying existing 'agy' sprite (silent bypass)...${RESET}"
        # Pipe 'y' to bypass the confirmation prompt
        echo "y" | sprite destroy agy >/dev/null
    fi
    
    echo -e "${CYAN}==> 3. Creating fresh 'agy' sprite instance...${RESET}"
    # Run the create command in the background, check if successful, and terminate the console session once created
    sprite create agy >/dev/null &
    CREATE_PID=$!
    
    # Wait for the sprite to be created by monitoring 'sprite list'
    for i in {1..30}; do
        if sprite list | grep -q "agy"; then
            break
        fi
        sleep 1
    done
    kill $CREATE_PID 2>/dev/null || true
    
    # Check if sprite was successfully created
    if ! sprite list | grep -q "agy"; then
        echo -e "${RED}Error: Failed to create 'agy' sprite.${RESET}" >&2
        exit 1
    fi
    
    echo -e "${CYAN}==> 4. Setting active sprite for current directory...${RESET}"
    sprite use agy >/dev/null
    
    # Read the local age key if it exists
    SOPS_KEY=""
    if [ -f "$HOME/.config/sops/age/keys.txt" ]; then
        SOPS_KEY=$(cat "$HOME/.config/sops/age/keys.txt")
    fi
    
    echo -e "${CYAN}==> 5. Transferring age keys and starting bootstrap on remote VM...${RESET}"
    # Pipe the script itself to bash on the remote VM, passing the SOPS key in the environment
    cat "$0" | sprite exec -- env SOPS_AGE_KEY="$SOPS_KEY" bash -s -- --remote
    
    exit $?
fi

set -euo pipefail
export USER=sprite

GREEN='\033[0;32m'; CYAN='\033[0;36m'; RESET='\033[0m'
step() { echo -e "\n${CYAN}▶ $*${RESET}"; }
ok()   { echo -e "${GREEN}✓ $*${RESET}"; }

step "Starting sprite bootstrap..."

# Ensure openssh-server is installed (required for the SSH tunnel and remote sshd service)
if ! command -v sshd >/dev/null 2>&1 && [ ! -f /usr/sbin/sshd ]; then
    step "Installing openssh-server (APT)..."
    sudo apt-get update
    sudo apt-get install -y openssh-server
fi
ok "openssh-server is installed"

# 1. Nix check/install
if ! command -v nix >/dev/null 2>&1; then
    step "Installing Nix (single-user)..."
    curl -L https://nixos.org/nix/install | sh -s -- --no-daemon --yes
    # Source nix profile
    if [ -f "$HOME/.nix-profile/etc/profile.d/nix.sh" ]; then
        source "$HOME/.nix-profile/etc/profile.d/nix.sh"
    elif [ -f "/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh" ]; then
        source "/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh"
    fi
    export PATH="$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:$PATH"
else
    ok "Nix is already installed: $(nix --version)"
fi

# 2. Clone repository
REPO_DIR="$HOME/sober-nix"
if [ ! -d "$REPO_DIR/.git" ]; then
    step "Cloning sober-nix repository..."
    git clone https://github.com/michaelssingh/sober-nix.git "$REPO_DIR"
else
    ok "Repository already cloned at $REPO_DIR"
    step "Updating repository..."
    git -C "$REPO_DIR" pull
fi

# 3. Setup SOPS age keys
mkdir -p "$HOME/.config/sops/age"
if [ -n "${SOPS_AGE_KEY:-}" ]; then
    echo "$SOPS_AGE_KEY" > "$HOME/.config/sops/age/keys.txt"
fi

if [ ! -f "$HOME/.config/sops/age/keys.txt" ]; then
    step "Setting up SOPS Age Key..."
    echo "No Age key found at ~/.config/sops/age/keys.txt."
    echo "Please copy/paste your SOPS decryption key (keys.txt) now."
    echo "Press ENTER when you have written it to ~/.config/sops/age/keys.txt."
    read -rp "Press Enter to continue..."
    if [ ! -f "$HOME/.config/sops/age/keys.txt" ]; then
        echo "Error: Key file was not found. Please create it manually and run this script again." >&2
        exit 1
    fi
fi
ok "SOPS Age Key ready"

# 4. Configure Nix local options for build optimization and sandboxing
step "Configuring Nix local options..."
mkdir -p "$HOME/.config/nix"
cat <<EOF > "$HOME/.config/nix/nix.conf"
sandbox = false
max-jobs = 8
cores = 0
experimental-features = nix-command flakes
substituters = https://cache.nixos.org https://sober-nix.cachix.org
trusted-public-keys = cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY= sober-nix.cachix.org-1:5txyMvuBOEoGah9zLW5SHrdLD92/h7eMiSv3VkErSG4=
EOF
ok "Nix local options configured (sandbox=false, max-jobs=8, cores=0, cachix=enabled)"

# 5. Apply Home Manager configuration
step "Applying Home Manager configuration (#sprite)..."
cd "$REPO_DIR"

nix run \
    --extra-experimental-features 'nix-command flakes' \
    github:nix-community/home-manager/release-26.05 \
    -- switch \
    --flake '.#sprite' \
    --extra-experimental-features 'nix-command flakes' \
    -b backup --refresh

ok "Home Manager applied successfully!"
echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${GREEN}✓ Your sprite is ready!${RESET}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""
echo "  Registered Sprite Services (sshd, nix-daemon) should now be active."
echo "  Use 'sprite-env services list' to inspect them."
