#!/usr/bin/env bash
# bin/sprite-tunnel — Tunnel manager for sober-surnia (Fly.io remote dev host).
#
# Establishes:
#   - SOCKS5 proxy (remote → otus → internet)
#   - SSH agent forwarding (remote → otus SSH agent)
#   - Port forwards for dev servers (5173, 4000)
#
# Usage: bin/sprite-tunnel {start|stop|restart|status}
#
# Run on otus before starting an agent session on surnia.

set -euo pipefail

APP="sober-surnia"
VM_HOST="init@${APP}.flycast"
VM_PORT="2222"
SOCKS_PORT=1080
AGENT_PORT=9000

SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ExitOnForwardFailure=yes -o ServerAliveInterval=30"

PID_DIR="$HOME/.cache/sprite-tunnel"
mkdir -p "$PID_DIR"

SOCAT_PID_FILE="$PID_DIR/socat.pid"
SSH_PID_FILE="$PID_DIR/ssh.pid"
SOCKS_PID_FILE="$PID_DIR/socks.pid"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── Process helpers ───────────────────────────────────────────────────────────
check_running() {
    local pid_file="$1"
    [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null
}

stop_process() {
    local name="$1" pid_file="$2"
    if check_running "$pid_file"; then
        local pid; pid=$(cat "$pid_file")
        echo "Stopping $name (PID $pid)..."
        kill "$pid" 2>/dev/null || true
        for _ in {1..30}; do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$pid_file"
}

stop_all() {
    stop_process "SSH tunnel"      "$SSH_PID_FILE"
    stop_process "socat (agent)"   "$SOCAT_PID_FILE"
    stop_process "SOCKS5 proxy"    "$SOCKS_PID_FILE"
}

# ── Ensure surnia is responsive ───────────────────────────────────────────────
ensure_surnia_up() {
    echo "Waking surnia (${APP}.flycast)..."
    local attempts=0
    until ssh $SSH_OPTS -p "$VM_PORT" "$VM_HOST" 'echo ok' &>/dev/null; do
        (( attempts++ ))
        [ $attempts -ge 24 ] && { echo "✗ surnia not reachable after 2 min"; exit 1; }
        echo -n "."
        sleep 5
    done
    echo " up."
}

# ── Start ─────────────────────────────────────────────────────────────────────
start_tunnel() {
    stop_all
    ensure_surnia_up

    # 1. SOCKS5 proxy (internet access from surnia)
    if [ -f "$SCRIPT_DIR/socks5-proxy.py" ]; then
        echo "Starting SOCKS5 proxy on port $SOCKS_PORT..."
        nohup python3 "$SCRIPT_DIR/socks5-proxy.py" "$SOCKS_PORT" >"$PID_DIR/socks.log" 2>&1 & disown
        echo $! >"$SOCKS_PID_FILE"
    else
        echo "  (socks5-proxy.py not found, skipping SOCKS5)"
    fi

    # 2. SSH agent bridge (socat: local sock → TCP port)
    if [ -z "${SSH_AUTH_SOCK:-}" ]; then
        echo "Warning: SSH_AUTH_SOCK not set — agent forwarding disabled"
    else
        echo "Starting SSH agent bridge on port $AGENT_PORT..."
        nohup socat TCP-LISTEN:"$AGENT_PORT",bind=127.0.0.1,reuseaddr,fork \
            UNIX-CONNECT:"$SSH_AUTH_SOCK" >"$PID_DIR/socat.log" 2>&1 & disown
        echo $! >"$SOCAT_PID_FILE"
    fi

    # 3. SSH tunnel with reverse port forwards + dev server forwards
    echo "Establishing SSH tunnel to ${VM_HOST}:${VM_PORT}..."
    nohup ssh $SSH_OPTS \
        -p "$VM_PORT" \
        -L 5173:127.0.0.1:5173 \
        -L 4000:127.0.0.1:4000 \
        -R "${SOCKS_PORT}:127.0.0.1:${SOCKS_PORT}" \
        -R "${AGENT_PORT}:127.0.0.1:${AGENT_PORT}" \
        -R "2223:127.0.0.1:22" \
        -N "$VM_HOST" >"$PID_DIR/ssh.log" 2>&1 & disown
    echo $! >"$SSH_PID_FILE"

    sleep 2

    echo ""
    echo "✓ Tunnel established to ${APP}"
    echo "  Frontend:     http://localhost:5173"
    echo "  Backend:      http://localhost:4000"
    echo "  SOCKS5:       Port $SOCKS_PORT (surnia → otus → internet)"
    echo "  Agent:        Port $AGENT_PORT (surnia → otus SSH agent)"
    echo "  Deploy back:  Port 2223 (surnia → otus SSH)"
    echo ""
    echo "  SSH in: ssh -p $VM_PORT $VM_HOST"
    echo "  Or:     bin/surnia ssh"
}

# ── Status ────────────────────────────────────────────────────────────────────
status_tunnel() {
    local ok=0

    check_running "$SOCKS_PID_FILE"  && echo "✓ SOCKS5 proxy running"    || { echo "✗ SOCKS5 proxy stopped"; ok=1; }
    check_running "$SOCAT_PID_FILE"  && echo "✓ Agent bridge running"     || { echo "✗ Agent bridge stopped"; ok=1; }
    check_running "$SSH_PID_FILE"    && echo "✓ SSH tunnel running"       || { echo "✗ SSH tunnel stopped";  ok=1; }

    echo ""
    fly status -a "$APP" 2>/dev/null || echo "(fly not available)"

    return $ok
}

# ── Entry point ───────────────────────────────────────────────────────────────
case "${1:-}" in
    start|restart) start_tunnel ;;
    stop)  stop_all; echo "✓ Tunnel stopped." ;;
    status) status_tunnel ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
