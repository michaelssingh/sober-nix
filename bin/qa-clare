#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

echo "=========================================="
echo " Running Clare Automated QA Pipeline Suite"
echo "=========================================="

cd "${REPO_DIR}/packages/clare"
CGO_ENABLED=0 go test -v -run "TestQAFullPipeline" .

echo "=========================================="
echo " ✓ Clare QA Pipeline Passed Successfully! "
echo "=========================================="
