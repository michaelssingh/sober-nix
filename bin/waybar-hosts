#!/usr/bin/env python3
"""
waybar-hosts — compact remote host status for Waybar.
Queries Fly.io app statuses and renders coloured dots.
Designed for low-resource hosts (no blocking SSH calls by default).
"""
import subprocess
import json
import os

# Augment PATH so `fly` is found even in Waybar's stripped environment
os.environ["PATH"] = ":".join([
    "/etc/profiles/per-user/michael/bin",  # fly, nh, etc.
    "/run/current-system/sw/bin",           # system tools
    "/nix/var/nix/profiles/default/bin",    # nix
    os.environ.get("PATH", ""),
])

# ── colours ──────────────────────────────────────────────────────────────────
GREEN  = "#98c379"
YELLOW = "#e5c07b"
GREY   = "#5c6370"

def dot(color): return f"<span color='{color}'>●</span>"

# ── Fly.io status query ───────────────────────────────────────────────────────
def fly_statuses():
    try:
        r = subprocess.run(
            ["fly", "apps", "list"],
            capture_output=True, text=True, timeout=5,
        )
        out = {}
        for line in r.stdout.splitlines():
            line = line.strip()
            if line.startswith("sober-"):
                parts = [p.strip() for p in line.split("│")]
                if len(parts) >= 3:
                    out[parts[0]] = parts[2]
        return out
    except Exception:
        return {}

# ── host descriptor ──────────────────────────────────────────────────────────
def host_label(name, status, short):
    if status in ("deployed", "running", "started"):
        return f"{short}:{dot(GREEN)}", f"{name}: active"
    elif status == "suspended":
        return f"{short}:{dot(YELLOW)}", f"{name}: suspended"
    else:
        return f"{short}:{dot(GREY)}", f"{name}: offline"

def main():
    fly = fly_statuses()

    hosts = [
        ("sober-bubo",   "B"),
        ("sober-strix",  "X"),
        ("sober-styx",   "S"),
        ("sober-surnia", "U"),
    ]

    labels, tips = [], []
    for app, short in hosts:
        status = fly.get(app, "unknown")
        lbl, tip = host_label(app, status, short)
        labels.append(lbl)
        tips.append(f"  {tip}")

    print(json.dumps({
        "text":    "󰒍 " + "  ".join(labels),
        "tooltip": "Remote Hosts:\n" + "\n".join(tips),
        "class":   "custom-hosts",
    }))

if __name__ == "__main__":
    main()
