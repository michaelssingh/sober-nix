#!/usr/bin/env bash
# Qutebrowser userscript to open or queue videos in MPV via mpv-queue

URL="${QUTE_URL:-$1}"

if [ -z "$URL" ]; then
    if [ -n "$QUTE_FIFO" ]; then
        echo "message-error 'view_in_mpv: No URL specified'" >> "$QUTE_FIFO"
    fi
    exit 1
fi

if [ -n "$QUTE_FIFO" ]; then
    echo "message-info 'Opening $URL in MPV...'" >> "$QUTE_FIFO"
fi

# Use mpv-queue to handle IPC socket, enqueueing, and playback cleanly
mpv-queue "$URL" >/dev/null 2>&1 &
