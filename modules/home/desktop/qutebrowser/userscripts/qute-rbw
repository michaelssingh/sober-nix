#!/usr/bin/env python3
import os
import sys
import subprocess
import urllib.parse
import re

def send_qute_command(cmd):
    fifo = os.environ.get('QUTE_FIFO')
    if fifo:
        with open(fifo, 'w') as f:
            f.write(cmd + '\n')
            f.flush()

def get_domain(url):
    if not url:
        return ""
    parsed = urllib.parse.urlparse(url)
    domain = parsed.netloc or parsed.path
    domain = re.sub(r'^www\.', '', domain)
    return domain.split(':')[0]

def ensure_unlocked():
    # Check if rbw is currently unlocked
    check = subprocess.run(['rbw', 'unlocked'], capture_output=True, text=True)
    if check.returncode == 0:
        return True

    # Run rbw unlock (triggers pinentry-rofi GUI password prompt)
    res = subprocess.run(['rbw', 'unlock'], capture_output=True, text=True)
    if res.returncode == 0:
        return True
    else:
        send_qute_command("message-error 'Failed to unlock Bitwarden (rbw)'")
        return False

def main():
    if not ensure_unlocked():
        sys.exit(0)

    url = os.environ.get('QUTE_URL', '')
    domain = get_domain(url)

    # 1. Fetch entries from rbw with fields name and user
    items = [] # List of tuples: (name, user, display_str)
    try:
        if domain:
            res = subprocess.run(['rbw', 'search', '--fields', 'name,user', domain], capture_output=True, text=True)
            lines = [l for l in res.stdout.strip().split('\n') if l.strip()]
        else:
            lines = []

        if not lines:
            res = subprocess.run(['rbw', 'list', '--fields', 'name,user'], capture_output=True, text=True, check=True)
            lines = [l for l in res.stdout.strip().split('\n') if l.strip()]

        for line in lines:
            parts = line.split('\t')
            name = parts[0].strip()
            user = parts[1].strip() if len(parts) > 1 else ""
            if name:
                display = f"{name}  |  {user}" if user else name
                items.append((name, user, display))

    except Exception as e:
        send_qute_command(f"message-error 'rbw failed: {e}'")
        sys.exit(1)

    if not items:
        send_qute_command("message-error 'No Bitwarden entries found in rbw'")
        sys.exit(1)

    # 2. Select entry
    selected_item = None
    if len(items) == 1:
        selected_item = items[0]
    else:
        # Prompt via rofi showing entry name and username
        rofi_input = '\n'.join([item[2] for item in items])
        try:
            p = subprocess.run(
                ['rofi', '-dmenu', '-i', '-p', f'Bitwarden ({domain or "All"})'],
                input=rofi_input,
                capture_output=True,
                text=True,
                check=True
            )
            choice = p.stdout.strip()
            for item in items:
                if item[2] == choice:
                    selected_item = item
                    break
        except subprocess.CalledProcessError:
            sys.exit(0) # User cancelled rofi

    if not selected_item:
        sys.exit(0)

    name, user, _ = selected_item

    # 3. Retrieve password using rbw get <name> [user]
    try:
        cmd = ['rbw', 'get', name]
        if user:
            cmd.append(user)
        
        password = subprocess.run(cmd, capture_output=True, text=True, check=True).stdout.strip()

        # 4. Always copy password to clipboard (so user can Ctrl+V anytime)
        subprocess.run(['wl-copy', password], check=False)

        # 5. Fill credentials into Qutebrowser via Base64-encoded JS DOM injection
        # Base64 encoding avoids qutebrowser command line argument parsing issues with spaces and quotes
        import json
        import base64

        raw_js = f"""
        (function() {{
            var u = {json.dumps(user)};
            var p = {json.dumps(password)};

            function fillField(el, val) {{
                if (!el || !val) return false;
                el.focus();
                el.value = val;
                el.dispatchEvent(new Event('input', {{ bubbles: true }}));
                el.dispatchEvent(new Event('change', {{ bubbles: true }}));
                return true;
            }}

            var passEl = document.querySelector('input[type="password"]');
            var userEl = (document.activeElement && document.activeElement.tagName === 'INPUT' && document.activeElement.type !== 'password')
                ? document.activeElement
                : document.querySelector('input[type="email"], input[name*="email"], input[name*="user"], input[name*="login"], input[autocomplete*="username"], input[type="text"]');

            fillField(userEl, u);
            fillField(passEl, p);
        }})();
        """

        b64_js = base64.b64encode(raw_js.encode('utf-8')).decode('utf-8')
        send_qute_command(f"jseval -q eval(atob('{b64_js}'))")

        # 5. Retrieve 2FA TOTP code using rbw code <name> [user]
        try:
            code_cmd = ['rbw', 'code', name]
            if user:
                code_cmd.append(user)
            
            code_res = subprocess.run(code_cmd, capture_output=True, text=True)
            if code_res.returncode == 0 and code_res.stdout.strip():
                totp = code_res.stdout.strip()
                subprocess.run(['wl-copy', totp], check=False)
                send_qute_command(f"message-info 'Logged in as {user or name} (2FA TOTP {totp} copied to clipboard!)'")
            else:
                send_qute_command(f"message-info 'Logged in as {user or name}'")
        except Exception:
            send_qute_command(f"message-info 'Logged in as {user or name}'")

    except Exception as e:
        send_qute_command(f"message-error 'Failed to get password from rbw: {e}'")

if __name__ == '__main__':
    main()
