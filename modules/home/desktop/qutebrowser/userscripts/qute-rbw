#!/usr/bin/env python3
import os
import sys
import subprocess
import urllib.parse
import re

def send_qute_command(cmd):
    fifo = os.environ.get('QUTE_FIFO')
    if fifo:
        with open(fifo, 'w') as f:
            f.write(cmd + '\n')
            f.flush()

def get_domain(url):
    if not url:
        return ""
    parsed = urllib.parse.urlparse(url)
    domain = parsed.netloc or parsed.path
    domain = re.sub(r'^www\.', '', domain)
    return domain.split(':')[0]

def main():
    url = os.environ.get('QUTE_URL', '')
    domain = get_domain(url)

    # 1. Fetch list of entries from rbw
    try:
        res = subprocess.run(['rbw', 'list'], capture_output=True, text=True, check=True)
        entries = [e.strip() for e in res.stdout.strip().split('\n') if e.strip()]
    except Exception as e:
        send_qute_command(f"message-error 'rbw list failed: {e}'")
        sys.exit(1)

    if not entries:
        send_qute_command("message-error 'No Bitwarden entries found in rbw'")
        sys.exit(1)

    # 2. Filter entries by domain matching
    matching = [e for e in entries if domain and domain.lower() in e.lower()]
    if not matching:
        matching = entries

    selected_entry = None
    if len(matching) == 1:
        selected_entry = matching[0]
    else:
        # Use rofi to prompt selection
        rofi_input = '\n'.join(matching)
        try:
            p = subprocess.run(
                ['rofi', '-dmenu', '-i', '-p', f'Bitwarden ({domain})'],
                input=rofi_input,
                capture_output=True,
                text=True,
                check=True
            )
            selected_entry = p.stdout.strip()
        except subprocess.CalledProcessError:
            sys.exit(0) # User cancelled rofi

    if not selected_entry:
        sys.exit(0)

    # 3. Get username & password for entry
    try:
        password = subprocess.run(['rbw', 'get', selected_entry], capture_output=True, text=True, check=True).stdout.strip()
        
        # Try fetching username field directly from rbw entry
        user = ""
        user_res = subprocess.run(['rbw', 'get', selected_entry, '--field', 'username'], capture_output=True, text=True)
        if user_res.returncode == 0 and user_res.stdout.strip():
            user = user_res.stdout.strip()
        elif '/' in selected_entry:
            user = selected_entry.split('/')[-1]
        elif '@' in selected_entry:
            user = selected_entry.split('@')[0]

        # 4. Fill into Qutebrowser via fake-key
        if user:
            send_qute_command(f"fake-key {user}")
            send_qute_command("fake-key <Tab>")
        send_qute_command(f"fake-key {password}")

        # 5. Check 2FA TOTP code and copy to clipboard
        code_res = subprocess.run(['rbw', 'code', selected_entry], capture_output=True, text=True)
        if code_res.returncode == 0 and code_res.stdout.strip():
            totp = code_res.stdout.strip()
            subprocess.run(['wl-copy', totp], check=False)
            send_qute_command(f"message-info 'Logged in as {user or selected_entry} (2FA TOTP {totp} copied to clipboard!)'")
        else:
            send_qute_command(f"message-info 'Logged in as {user or selected_entry}'")

    except Exception as e:
        send_qute_command(f"message-error 'Failed to get credentials from rbw: {e}'")

if __name__ == '__main__':
    main()
